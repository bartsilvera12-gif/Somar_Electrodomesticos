# =====================================================================
#  SOMAR Electrodomésticos — Variables de entorno (ejemplo)
#  El frontend público usa js/config.js (ANON KEY, pública).
#  Estas variables son para tareas administrativas / CLI de Supabase.
# =====================================================================

# URL del proyecto Supabase (API)
SUPABASE_URL=https://api.neura.com.py

# Clave pública (segura para el navegador). Va en js/config.js.
SUPABASE_ANON_KEY=pega_aqui_tu_anon_key

# Clave SECRETA. NUNCA en el frontend ni en el repositorio.
# Usar solo local para migraciones/seed con la CLI. Rotar si se expone.
# SUPABASE_SERVICE_ROLE_KEY=solo_local_no_commitear

# Schema del proyecto (debe exponerse en PostgREST)
SUPABASE_DB_SCHEMA=somarelectrodomesticos

# Bucket de Storage para medios
SUPABASE_STORAGE_BUCKET=somar-media
